# ============================================================
# .env.example  —  Sports Ticketing Platform
# cp .env.example .env  →  fill in your real values
# NEVER commit .env to git
# ============================================================

# ── Docker image registry prefix ──────────────────────────
DOCKER_REGISTRY=surajpaudel4833
APP_VERSION=v1.0.0-foundation

# ── Spring profile active ──────────────────────────────────
# "docker" activates Docker-specific config in your services
SPRING_PROFILES_ACTIVE=docker

# ── Config Server ──────────────────────────────────────────
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_SERVER_PORT=8888

# Git-backed config repo
CONFIG_GIT_URI=https://github.com/surajpaudel2/sports-ticketing-configserver.git
CONFIG_GIT_BRANCH=main

# ── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=5672       # AMQP — Spring Boot / Spring Cloud Bus
RABBITMQ_MGMT_PORT=15672      # HTTP Management UI

# ── Service ports (host-side) ──────────────────────────────
EVENT_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
